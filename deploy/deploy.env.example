# 复制为 deploy.env（不要提交）。真实部署时在平台“Secrets/环境变量”中填写，不写进镜像。
GUANLAN_BASIC_AUTH=reviewer:请改成至少12位的随机密码
GUANLAN_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765
GUANLAN_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# 公网域名示例：GUANLAN_ALLOWED_HOSTS=guanlan.example.com  GUANLAN_ALLOWED_ORIGINS=https://guanlan.example.com
GUANLAN_DISABLE_AI=1
GUANLAN_AI_DAILY_LIMIT=20
GUANLAN_PRICES_PER_MINUTE=6
GUANLAN_DISABLE_REFRESH=0
# 常驻服务器设 1；会休眠的平台保持 0
GUANLAN_SCHEDULE=0
# 每个刷新并发都是独立的 python+akshare 子进程；1GB 以下实例建议 1–2
GUANLAN_REFRESH_WORKERS=2
# 只有在你控制的反向代理之后才设为 1
GUANLAN_TRUST_PROXY=0
# 开启 AI 时才填写（服务端保管）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
